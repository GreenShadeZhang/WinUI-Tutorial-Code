<Project>
  <PropertyGroup Condition="'$(PublishProfile)' != '' and !Exists('$(MSBuildProjectDirectory)\$(PublishProfile)')">
    <PublishProfile></PublishProfile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Update="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Update="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Update="CommunityToolkit.WinUI.Collections" Version="8.2.251219" />
    <PackageReference Update="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Update="CommunityToolkit.WinUI.Helpers" Version="8.2.251219" />
    <PackageReference Update="HelixToolkit" Version="2.27.3" />
    <PackageReference Update="HelixToolkit.SharpDX.Assimp" Version="2.27.3" />
    <PackageReference Update="HelixToolkit.SharpDX.Core" Version="2.27.3" />
    <PackageReference Update="HelixToolkit.WinUI" Version="2.27.3" />
    <PackageReference Update="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Update="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Update="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Update="Microsoft.ML" Version="5.0.1" />
    <PackageReference Update="Microsoft.ML.LightGbm" Version="5.0.1" />
    <PackageReference Update="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
    <PackageReference Update="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Update="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Update="OpenCvSharp4.Extensions" Version="4.13.0.20260627" />
    <PackageReference Update="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <PackageReference Update="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Update="System.Drawing.Common" Version="10.0.13" />
    <PackageReference Update="System.IO.Ports" Version="10.0.13" />
    <PackageReference Update="WinUIEx" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseWinUI)' == 'true'">
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.7.1" />
  </ItemGroup>
</Project>
